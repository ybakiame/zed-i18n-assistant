{
  "$schema": "https://raw.githubusercontent.com/ybakiame/zed-i18n-assistant/main/schema/i18n-assistant.schema.json",
  "defaultLocale": "zh-CN",
  "localeDirs": ["src/locales", "src/i18n", "locales", "i18n"],
  "rawTextDiagnostics": true,
  "inlayHints": {
    "enabled": true,
    "maxLength": 24
  },
  "packages": [
    {
      "root": "apps/web",
      "defaultLocale": "zh-CN",
      "localeDirs": ["src/locales"]
    },
    {
      "root": "packages/admin",
      "defaultLocale": "en-US",
      "localeDirs": ["src/i18n"],
      "localeDirsMode": "override"
    }
  ]
}
